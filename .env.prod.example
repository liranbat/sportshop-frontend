# Copy to .env.prod (gitignored). Consumed by sportshop-deploy/docker-compose.yml.
# entrypoint.sh strips APP_ prefix → window.APP_CONFIG; src/config.ts reads config.FOO.
# New keys: add APP_FOO here (use VITE_APP_FOO in .env for dev).

APP_ENV_LABEL=prod

APP_API_BASE_URL=/api
APP_API_TIMEOUT_MS=30000
APP_TOAST_DURATION_MS=5000
