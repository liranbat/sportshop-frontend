# Copy to .env (gitignored). Vite exposes VITE_APP_* to client code at dev time.
# New keys: add VITE_APP_FOO here; src/config.ts reads config.FOO.

# Dev-server proxy target for /api/* and /images/* (vite.config.ts).
VITE_APP_PROXY_TARGET=http://localhost:8080

VITE_APP_ENV_LABEL=dev

VITE_APP_API_BASE_URL=/api
VITE_APP_API_TIMEOUT_MS=30000
VITE_APP_TOAST_DURATION_MS=5000
